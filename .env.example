# Copy to .env and fill in. Never commit .env.
CHAINSTACK_URL=https://ethereum-mainnet.core.chainstack.com/YOUR_KEY
# Optional: any second, independent Ethereum RPC used by `verify` (e.g. a public node)
VERIFY_RPC_URL=
# Optional: free Etherscan API key, used only for funder lookup in `attribute --funders`
ETHERSCAN_API_KEY=
